create table message (id int primary key, text varchar(10)) softdelete retention 7 day;
set @@tidb_translate_softdelete_sql = true;
insert into message values (1, '24h'), (2, '24h');
insert into message values (2, 'new') on duplicate key update text = 'new';
select * from message where id = 2;
select * from message order by id;

# Unchanged primary key should be updated successfully
insert into message values (2, 'dup') on duplicate key update id = 2, text = 'dup';
select * from message where id = 2;

# Test INSERT ON DUPLICATE KEY UPDATE primary key should fail
-- error 1235
insert into message values (2, 'new') on duplicate key update id = 3;
drop table message;

# PK with ON UPDATE CURRENT_TIMESTAMP should fail when implicit on-update-now is triggered
create table t_onupdate (a timestamp(0) on update current_timestamp(0), b int, primary key (a) clustered) softdelete retention 7 day;
insert into t_onupdate values ('2000-01-01 00:00:00', 1);
-- error 1235
insert into t_onupdate values ('2000-01-01 00:00:00', 2) on duplicate key update b = values(b);
insert into t_onupdate values ('2000-01-01 00:00:00', 2) on duplicate key update a = '2000-01-01 00:00:00', b = values(b);
select a, b from t_onupdate;
drop table t_onupdate;

create table t_onupdate (a timestamp(0) on update current_timestamp(0), b int, primary key (a) nonclustered) softdelete retention 7 day;
insert into t_onupdate values ('2000-01-01 00:00:00', 1);
-- error 1235
insert into t_onupdate values ('2000-01-01 00:00:00', 2) on duplicate key update b = values(b);
insert into t_onupdate values ('2000-01-01 00:00:00', 2) on duplicate key update a = values(a), b = values(b);
select a, b from t_onupdate;
drop table t_onupdate;

# Generated column primary key should also be immutable on soft-delete table
create table t_genpk (b int not null, a int as (b % 2) stored, v int, primary key (a) clustered) softdelete retention 7 day;
insert into t_genpk (b, v) values (1, 1);
insert into t_genpk (b, v) values (3, 2) on duplicate key update b = values(b), v = values(v);
select a, b, v from t_genpk;
-- error 1235
insert into t_genpk (b, v) values (1, 3) on duplicate key update b = 2, v = values(v);
select a, b, v from t_genpk;
drop table t_genpk;

create table t_genpk (b int not null, a int as (b % 2) stored, v int, primary key (a) nonclustered) softdelete retention 7 day;
insert into t_genpk (b, v) values (1, 1);
insert into t_genpk (b, v) values (3, 2) on duplicate key update b = values(b), v = values(v);
select a, b, v from t_genpk;
-- error 1235
insert into t_genpk (b, v) values (1, 3) on duplicate key update b = 2, v = values(v);
select a, b, v from t_genpk;
drop table t_genpk;

create table t (id int primary key clustered, v int) softdelete retention 7 day;
insert into t (id, v) values (1, 1), (2, 2), (3, 3), (4, 4);
# soft delete (1, 1), (2, 2)
delete from t where id in (1, 2);

# multiple duplicate id = 3, 4, multiple tombstone id = 1, 2
insert into t (id, v) values (1, 11), (2, 12), (3, 13), (4, 14), (5, 15) on duplicate key update v = 666;
select id, v from t;
select * from t;

# test insert ignore + on duplicate
truncate table t;
insert into t (id, v) values (1, 1), (2, 2), (3, 3);
delete from t where id = 1;
-- error 1292
insert into t values (2, 222) on duplicate key update v = 'abcd';
insert ignore into t values (2, 222) on duplicate key update v = 'abcd';
show warnings;
select id, v from t;
# modify primary key is not supported on soft-delete table
-- error 1235
insert into t values (2, 22) on duplicate key update id = 3;
-- error 1235
insert ignore into t values (2, 22) on duplicate key update id = 3;
select id, v from t;

# What if the on duplicate key update row duplicates with soft-deleted row again?
# Currently we do not support changing the primary key, so this case would not happen.
# TODO: update here when changing primary key is supported
# tk.MustExec(`insert into t2 (id, v) values (1, 1), (2, 2)`)
# tk.MustExec(`update t2 set _tidb_softdelete_time = now() where id = 1`)
